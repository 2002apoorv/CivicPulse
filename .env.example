# CivicPulse Environment Configuration

# Server
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="CivicPulse — AI Grievance Intelligence"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security
SECRET_KEY=civicpulse-development-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For PostgreSQL with pgvector (default for production or docker-compose):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/civicpulse
# Fallback to local SQLite for instant zero-dependency development/testing on Windows:
DATABASE_URL=sqlite:///./civicpulse.db

# Vector Storage Configuration
# Options: 'pgvector' (requires PostgreSQL + pgvector) or 'in_memory' (numpy cosine vector index with db persistence)
VECTOR_STORE_BACKEND=in_memory

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML / NLP Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CLASSIFIER_MODEL_PATH=server/app/ml/models/classifier_baseline.joblib
SPACY_MODEL_NAME=en_core_web_sm
SIMILARITY_THRESHOLD=0.65
CLUSTER_EPS_METERS=500
CLUSTER_MIN_SAMPLES=2

# Default Admin User Bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@civicpulse.local
BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePass2026!
BOOTSTRAP_ADMIN_NAME="System Administrator"
